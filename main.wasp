app OpenSaaS {
  wasp: {
    version: "^0.18.0"
  },

  title: "LicenseDent - Gulf + Ireland Dental Licensing Exam Prep",

  head: [
    "<link rel='icon' href='/licensedent-favicon.svg' type='image/svg+xml' />",
    "<meta charset='utf-8' />",
    "<meta name='description' content='Practice-question bank, timed mock tests and subject-wise revision for DHA, HAAD, MOH, SMLE and IDC Ireland dental licensing exams.' />",
    "<meta name='author' content='LicenseDent' />",
    "<meta name='keywords' content='DHA exam prep, HAAD exam, IDC Ireland exam, dental licensing exam, dentist mock test, DHA MCQs, LicenseDent' />",

    "<meta property='og:type' content='website' />",
    "<meta property='og:title' content='LicenseDent - Gulf + Ireland Dental Licensing Exam Prep' />",
    "<meta property='og:site_name' content='LicenseDent' />",
    "<meta property='og:url' content='https://licensedent.example.com' />",
    "<meta property='og:description' content='Practice-question bank, timed mock tests and subject-wise revision for DHA, HAAD, MOH, SMLE and IDC Ireland dental licensing exams.' />",
    "<meta property='og:image' content='https://licensedent.example.com/licensedent-logo-primary.svg' />",
    "<meta name='twitter:image' content='https://licensedent.example.com/licensedent-logo-primary.svg' />",
    "<meta name='twitter:image:width' content='800' />",
    "<meta name='twitter:image:height' content='400' />",
    "<meta name='twitter:card' content='summary_large_image' />",
    // TODO: You can put your Plausible analytics scripts below (https://docs.opensaas.sh/guides/analytics/):
    // NOTE: Plausible does not use Cookies, so you can simply add the scripts here.
    // Google, on the other hand, does, so you must instead add the script dynamically
    // via the Cookie Consent component after the user clicks the "Accept" cookies button.
    "<script defer data-domain='<your-site-id>' src='https://plausible.io/js/script.js'></script>",  // for production
    "<script defer data-domain='<your-site-id>' src='https://plausible.io/js/script.local.js'></script>",  // for development
  ],

  // 🔐 Auth out of the box! https://wasp.sh/docs/auth/overview
  auth: {
    userEntity: User,
    methods: {
      // NOTE: If you decide to not use email auth, make sure to also delete the related routes and pages below.
      //   (RequestPasswordReset(Route|Page), PasswordReset(Route|Page), EmailVerification(Route|Page))
      email: {
        fromField: {
          name: "LicenseDent",
          email: "support@licensedent.com"
        },
        emailVerification: {
          clientRoute: EmailVerificationRoute,
          getEmailContentFn: import { getVerificationEmailContent } from "@src/auth/email-and-pass/emails",
        },
        passwordReset: {
          clientRoute: PasswordResetRoute,
          getEmailContentFn: import { getPasswordResetEmailContent } from "@src/auth/email-and-pass/emails",
        },
        userSignupFields: import { getEmailUserFields } from "@src/auth/userSignupFields",
      },
      // Uncomment to enable Google Auth (check https://wasp.sh/docs/auth/social-auth/google for setup instructions):
      // google: { // Guide for setting up Auth via Google
      //   userSignupFields: import { getGoogleUserFields } from "@src/auth/userSignupFields",
      //   configFn: import { getGoogleAuthConfig } from "@src/auth/userSignupFields",
      // },
      // Uncomment to enable GitHub Auth (check https://wasp.sh/docs/auth/social-auth/github for setup instructions):
      // gitHub: {
      //   userSignupFields: import { getGitHubUserFields } from "@src/auth/userSignupFields",
      //   configFn: import { getGitHubAuthConfig } from "@src/auth/userSignupFields",
      // },
      // Uncomment to enable Discord Auth (check https://wasp.sh/docs/auth/social-auth/discord for setup instructions):
      // discord: {
      //   userSignupFields: import { getDiscordUserFields } from "@src/auth/userSignupFields",
      //   configFn: import { getDiscordAuthConfig } from "@src/auth/userSignupFields"
      // }
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/dashboard",
    onBeforeLogin: import { onBeforeLoginHook } from "@src/auth/hooks",
  },

  db: {
    // Run `wasp db seed` to seed the database with the seed functions below:
    seeds: [
      // Populates the database with a bunch of fake users to work with during development.
      import { seedMockUsers } from "@src/server/scripts/dbSeeds",
    ]
  },

  client: {
    rootComponent: import App from "@src/client/App",
  },

  emailSender: {
    // NOTE: "Dummy" provider is just for local development purposes.
    //   Make sure to check the server logs for the email confirmation url (it will not be sent to an address)!
    //   Once you are ready for production, switch to e.g. "SendGrid" or "Mailgun" providers. Check out https://docs.opensaas.sh/guides/email-sending/ .
    provider: Dummy,
    defaultFrom: {
      name: "LicenseDent",
      // When using a real provider, e.g. SendGrid, you must use the same email address that you configured your account to send out emails with!
      email: "support@licensedent.com"
    },
  },

  server: {
    // Raises the default 100kb request-body cap -- see serverSetup.ts for why
    // (question-import posts a whole PDF's extracted text as one JSON body).
    middlewareConfigFn: import { serverMiddlewareFn } from "@src/server/serverSetup",
  },
}

route LandingPageRoute { path: "/", to: LandingPage }
page LandingPage {
  component: import LandingPage from "@src/landing-page/LandingPage"
}

query getPublicExams {
  fn: import { getPublicExams } from "@src/landing-page/operations",
  entities: [Exam]
}

query getPublicBankStats {
  fn: import { getPublicBankStats } from "@src/landing-page/operations",
  entities: [Question, Subject, Exam]
}

//#region Legal (public — terms of service, refund policy, disclaimers)
route LegalRoute { path: "/legal", to: LegalPage }
page LegalPage {
  component: import LegalPage from "@src/legal/LegalPage"
}
//#endregion

//#region Demo Exam (public, front-end only — no auth, no DB, sample questions)
route DemoExamRoute { path: "/demo-exam", to: DemoExamPage }
page DemoExamPage {
  component: import DemoExamPage from "@src/demo-exam/DemoExamPage"
}
//#endregion

//#region Exam guide pages (public, front-end only — one per exam)
route AllExamsRoute { path: "/exams", to: AllExamsPage }
page AllExamsPage {
  component: import AllExamsPage from "@src/exam-pages/AllExamsPage"
}

route DhaExamRoute { path: "/exams/dha", to: DhaExamPage }
page DhaExamPage {
  component: import DhaExamPage from "@src/exam-pages/DhaExamPage"
}

route HaadExamRoute { path: "/exams/haad", to: HaadExamPage }
page HaadExamPage {
  component: import HaadExamPage from "@src/exam-pages/HaadExamPage"
}

route MohExamRoute { path: "/exams/moh", to: MohExamPage }
page MohExamPage {
  component: import MohExamPage from "@src/exam-pages/MohExamPage"
}

route SmleExamRoute { path: "/exams/smle", to: SmleExamPage }
page SmleExamPage {
  component: import SmleExamPage from "@src/exam-pages/SmleExamPage"
}

route OmsbExamRoute { path: "/exams/omsb", to: OmsbExamPage }
page OmsbExamPage {
  component: import OmsbExamPage from "@src/exam-pages/OmsbExamPage"
}

route QchpExamRoute { path: "/exams/qchp", to: QchpExamPage }
page QchpExamPage {
  component: import QchpExamPage from "@src/exam-pages/QchpExamPage"
}

route KmleExamRoute { path: "/exams/kmle", to: KmleExamPage }
page KmleExamPage {
  component: import KmleExamPage from "@src/exam-pages/KmleExamPage"
}

route NhraExamRoute { path: "/exams/nhra", to: NhraExamPage }
page NhraExamPage {
  component: import NhraExamPage from "@src/exam-pages/NhraExamPage"
}

route ShaExamRoute { path: "/exams/sha", to: ShaExamPage }
page ShaExamPage {
  component: import ShaExamPage from "@src/exam-pages/ShaExamPage"
}

route IdcExamRoute { path: "/exams/idc-ireland", to: IdcExamPage }
page IdcExamPage {
  component: import IdcExamPage from "@src/exam-pages/IdcExamPage"
}
//#endregion

//#region Auth Pages
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@src/auth/LoginPage"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import { Signup } from "@src/auth/SignupPage"
}

route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }
page RequestPasswordResetPage {
  component: import { RequestPasswordResetPage } from "@src/auth/email-and-pass/RequestPasswordResetPage",
}

route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
page PasswordResetPage {
  component: import { PasswordResetPage } from "@src/auth/email-and-pass/PasswordResetPage",
}

route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }
page EmailVerificationPage {
  component: import { EmailVerificationPage } from "@src/auth/email-and-pass/EmailVerificationPage",
}
//#endregion

//#region User
route AccountRoute { path: "/account", to: AccountPage }
page AccountPage {
  authRequired: true,
  component: import Account from "@src/user/AccountPage"
}

query getPaginatedUsers {
  fn: import { getPaginatedUsers } from "@src/user/operations",
  entities: [User, Subscription]
}

action updateIsUserAdminById {
  fn: import { updateIsUserAdminById } from "@src/user/operations",
  entities: [User]
}
//#endregion

//#region Payment
route PricingPageRoute { path: "/pricing", to: PricingPage }
page PricingPage {
  component: import PricingPage from "@src/payment/PricingPage"
}

route CheckoutRoute { path: "/checkout", to: CheckoutPage }
page CheckoutPage {
  authRequired: true,
  component: import Checkout from "@src/payment/CheckoutPage"
}

query getCustomerPortalUrl {
  fn: import { getCustomerPortalUrl } from  "@src/payment/operations",
  entities: [User]
}

query getMySubscription {
  fn: import { getMySubscription } from "@src/payment/operations",
  entities: [Subscription]
}

query getMySubscriptionHistory {
  fn: import { getMySubscriptionHistory } from "@src/payment/operations",
  entities: [Subscription]
}

query getEffectiveAccess {
  fn: import { getMyEffectiveAccess } from "@src/payment/operations",
  entities: [Subscription, UserAttempt]
}

route BillingRoute { path: "/billing", to: BillingPage }
page BillingPage {
  authRequired: true,
  component: import BillingPage from "@src/dashboard/BillingPage"
}

action generateCheckoutSession {
  fn: import { generateCheckoutSession } from "@src/payment/operations",
  entities: [User, Exam]
}

api paymentsWebhook {
  fn: import { paymentsWebhook } from "@src/payment/webhook",
  entities: [User, Subscription],
  middlewareConfigFn: import { paymentsMiddlewareConfigFn } from "@src/payment/webhook",
  httpRoute: (POST, "/payments-webhook")
}
//#endregion

//#region Analytics
query getDailyStats {
  fn: import { getDailyStats } from "@src/analytics/operations",
  entities: [User, DailyStats]
}

job dailyStatsJob {
  executor: PgBoss,
  perform: {
    fn: import { calculateDailyStats } from "@src/analytics/stats"
  },
  schedule: {
    cron: "0 * * * *" // every hour. useful in production
    // cron: "* * * * *" // every minute. useful for debugging
  },
  entities: [User, DailyStats, Logs, PageViewSource]
}
//#endregion

//#region Admin Dashboard
route AdminRoute { path: "/admin", to: AnalyticsDashboardPage }
page AnalyticsDashboardPage {
  authRequired: true,
  component: import AnalyticsDashboardPage from "@src/admin/dashboards/analytics/AnalyticsDashboardPage"
}

route AdminUsersRoute { path: "/admin/users", to: AdminUsersPage }
page AdminUsersPage {
  authRequired: true,
  component: import AdminUsers from "@src/admin/dashboards/users/UsersDashboardPage"
}

route AdminUserDetailRoute { path: "/admin/users/:userId", to: AdminUserDetailPage }
page AdminUserDetailPage {
  authRequired: true,
  component: import AdminUserDetail from "@src/admin/dashboards/users/UserDetailPage"
}

query getUsersOverviewStats {
  fn: import { getUsersOverviewStats } from "@src/admin/dashboards/users/operations",
  entities: [User]
}

query getUserDetail {
  fn: import { getUserDetail } from "@src/admin/dashboards/users/operations",
  entities: [User]
}

query getUserNotes {
  fn: import { getUserNotes } from "@src/admin/dashboards/users/operations",
  entities: [AdminUserNote]
}

action addUserNote {
  fn: import { addUserNote } from "@src/admin/dashboards/users/operations",
  entities: [AdminUserNote]
}

action deleteUserNote {
  fn: import { deleteUserNote } from "@src/admin/dashboards/users/operations",
  entities: [AdminUserNote]
}

action updateUserTags {
  fn: import { updateUserTags } from "@src/admin/dashboards/users/operations",
  entities: [User]
}

action updateUserProfileByAdmin {
  fn: import { updateUserProfileByAdmin } from "@src/admin/dashboards/users/operations",
  entities: [UserProfile]
}

query getUserSubscriptions {
  fn: import { getUserSubscriptions } from "@src/admin/dashboards/users/operations",
  entities: [Subscription]
}

action grantUserSubscription {
  fn: import { grantUserSubscription } from "@src/admin/dashboards/users/operations",
  entities: [Subscription]
}

action revokeUserSubscription {
  fn: import { revokeUserSubscription } from "@src/admin/dashboards/users/operations",
  entities: [Subscription]
}

action toggleUserDisabled {
  fn: import { toggleUserDisabled } from "@src/admin/dashboards/users/operations",
  entities: [User]
}

action inviteUser {
  fn: import { inviteUser } from "@src/admin/dashboards/users/operations",
  entities: [User]
}

action sendUserPasswordReset {
  fn: import { sendUserPasswordReset } from "@src/admin/dashboards/users/operations",
  entities: [User]
}

query getUserActivitySummary {
  fn: import { getUserActivitySummary } from "@src/admin/dashboards/users/operations",
  entities: [User, UserAttempt, MockExamAttempt]
}

route AdminExamsRoute { path: "/admin/exams", to: AdminExamsPage }
page AdminExamsPage {
  authRequired: true,
  component: import AdminExams from "@src/admin/dashboards/exams/ExamsManagementPage"
}

action updateExam {
  fn: import { updateExam } from "@src/admin/dashboards/exams/operations",
  entities: [Exam]
}

action createExam {
  fn: import { createExam } from "@src/admin/dashboards/exams/operations",
  entities: [Exam]
}

route AdminQuestionsRoute { path: "/admin/questions", to: AdminQuestionsPage }
page AdminQuestionsPage {
  authRequired: true,
  component: import AdminQuestions from "@src/admin/dashboards/questions/QuestionsReviewPage"
}

route AdminImportQuestionsRoute { path: "/admin/questions/import", to: AdminImportQuestionsPage }
page AdminImportQuestionsPage {
  authRequired: true,
  component: import AdminImportQuestions from "@src/admin/dashboards/questions/ImportQuestionsPage"
}

route AdminAuditLogRoute { path: "/admin/audit-log", to: AdminAuditLogPage }
page AdminAuditLogPage {
  authRequired: true,
  component: import AdminAuditLog from "@src/admin/dashboards/auditLog/AuditLogPage"
}

query getAdminAuditLog {
  fn: import { getAdminAuditLog } from "@src/admin/dashboards/auditLog/operations",
  entities: [AdminAuditLog, User]
}

route NotFoundRoute { path: "*", to: NotFoundPage }
page NotFoundPage {
  component: import { NotFoundPage } from "@src/client/components/NotFoundPage"
}
//#endregion

//#region Question Review (dental exam-prep admin queue)
query getImportBatches {
  fn: import { getImportBatches } from "@src/admin/dashboards/questions/operations",
  entities: [ImportBatch]
}

query getSubjectsForReview {
  fn: import { getSubjectsForReview } from "@src/admin/dashboards/questions/operations",
  entities: [Subject, Question]
}

query getQuestionBankStats {
  fn: import { getQuestionBankStats } from "@src/admin/dashboards/questions/operations",
  entities: [Question, Subject]
}

query getReviewerActivityStats {
  fn: import { getReviewerActivityStats } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

query getAdminOverviewStats {
  fn: import { getAdminOverviewStats } from "@src/admin/dashboards/overview/operations",
  entities: [User, Subscription, ContactFormMessage]
}

query getAdminGrowthSeries {
  fn: import { getAdminGrowthSeries } from "@src/admin/dashboards/overview/operations",
  entities: [User]
}

query getAdminReviewVelocity {
  fn: import { getAdminReviewVelocity } from "@src/admin/dashboards/overview/operations",
  entities: [Question]
}

query getAdminRecentActivity {
  fn: import { getAdminRecentActivity } from "@src/admin/dashboards/overview/operations",
  entities: [User, Subscription, ContactFormMessage, AdminAuditLog]
}

query getQuestionVersions {
  fn: import { getQuestionVersions } from "@src/admin/dashboards/questions/operations",
  entities: [QuestionVersion]
}

query getQuestionById {
  fn: import { getQuestionById } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

query searchQuestions {
  fn: import { searchQuestions } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

action createSubject {
  fn: import { createSubject } from "@src/admin/dashboards/questions/operations",
  entities: [Exam, Subject]
}

action updateSubject {
  fn: import { updateSubject } from "@src/admin/dashboards/questions/operations",
  entities: [Subject]
}

action deleteSubject {
  fn: import { deleteSubject } from "@src/admin/dashboards/questions/operations",
  entities: [Subject, Question]
}

query getQuestionsForReview {
  fn: import { getQuestionsForReview } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

action updateReviewQuestion {
  fn: import { updateReviewQuestion } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

action approveQuestion {
  fn: import { approveQuestion } from "@src/admin/dashboards/questions/operations",
  entities: [Question, ImportBatch]
}

action unpublishQuestion {
  fn: import { unpublishQuestion } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

action rejectQuestion {
  fn: import { rejectQuestion } from "@src/admin/dashboards/questions/operations",
  entities: [Question, ImportBatch]
}

action deleteQuestion {
  fn: import { deleteQuestion } from "@src/admin/dashboards/questions/operations",
  entities: [Question, QuestionVersion, QuestionNote, UserAttempt, MockExamAttemptItem, ReviewSchedule, CustomQuizAttemptItem, ImportBatch]
}

action bulkQuestionAction {
  fn: import { bulkQuestionAction } from "@src/admin/dashboards/questions/operations",
  entities: [Question, ImportBatch, QuestionVersion, QuestionNote, UserAttempt, MockExamAttemptItem, ReviewSchedule, CustomQuizAttemptItem, Subject]
}

query getExamsForAdmin {
  fn: import { getExamsForAdmin } from "@src/admin/dashboards/questions/operations",
  entities: [Exam]
}

query getSubjectsForExam {
  fn: import { getSubjectsForExam } from "@src/admin/dashboards/questions/operations",
  entities: [Subject]
}

action importQuestionsFromText {
  fn: import { importQuestionsFromText } from "@src/admin/dashboards/questions/operations",
  entities: [Exam, Subject, Question, ImportBatch]
}

action draftAiSuggestion {
  fn: import { draftAiSuggestion } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

action draftAiSuggestionsForSubject {
  fn: import { draftAiSuggestionsForSubject } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

action getQuestionImageUploadUrl {
  fn: import { getQuestionImageUploadUrl } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}

action setQuestionImage {
  fn: import { setQuestionImage } from "@src/admin/dashboards/questions/operations",
  entities: [Question]
}
//#endregion

//#region Practice mode (student-facing MCQ engine)
route PracticeRoute { path: "/practice", to: PracticePage }
page PracticePage {
  authRequired: true,
  component: import PracticePage from "@src/questions/PracticePage"
}

query getPracticeSubjects {
  fn: import { getPracticeSubjects } from "@src/questions/operations",
  entities: [Subject, Exam]
}

query getPracticeQuestions {
  fn: import { getPracticeQuestions } from "@src/questions/operations",
  entities: [Question, QuestionNote]
}

action submitAnswer {
  fn: import { submitAnswer } from "@src/questions/operations",
  entities: [Question, UserAttempt, ReviewSchedule]
}

route ReviewRoute { path: "/practice/review", to: ReviewPage }
page ReviewPage {
  authRequired: true,
  component: import ReviewPage from "@src/questions/ReviewPage"
}

action saveQuestionNote {
  fn: import { saveQuestionNote } from "@src/questions/operations",
  entities: [QuestionNote]
}

query getMyMarkedQuestions {
  fn: import { getMyMarkedQuestions } from "@src/questions/operations",
  entities: [QuestionNote]
}

route SmartReviewRoute { path: "/practice/smart-review", to: SmartReviewPage }
page SmartReviewPage {
  authRequired: true,
  component: import SmartReviewPage from "@src/questions/SmartReviewPage"
}

query getDueReviewQuestions {
  fn: import { getDueReviewQuestions } from "@src/questions/operations",
  entities: [ReviewSchedule, Question, QuestionNote]
}

query getDueReviewCount {
  fn: import { getDueReviewCount } from "@src/questions/operations",
  entities: [ReviewSchedule]
}
//#endregion

//#region Quiz Builder (Extended-plan perk -- Phase 1: practice-mode filters, Phase 2: timed/exam mode)
route QuizBuilderRoute { path: "/quiz-builder", to: QuizBuilderPage }
page QuizBuilderPage {
  authRequired: true,
  component: import QuizBuilderPage from "@src/quiz-builder/QuizBuilderPage"
}

query getCustomQuizMatchCount {
  fn: import { getCustomQuizMatchCount } from "@src/questions/operations",
  entities: [Question, UserAttempt, QuestionNote]
}

query getCustomQuizQuestions {
  fn: import { getCustomQuizQuestions } from "@src/questions/operations",
  entities: [Question, UserAttempt, QuestionNote]
}

route CustomQuizAttemptRoute { path: "/quiz-builder/:attemptId", to: CustomQuizAttemptPage }
page CustomQuizAttemptPage {
  authRequired: true,
  component: import CustomQuizAttemptPage from "@src/quiz-builder/CustomQuizAttemptPage"
}

route CustomQuizResultsRoute { path: "/quiz-builder/:attemptId/results", to: CustomQuizResultsPage }
page CustomQuizResultsPage {
  authRequired: true,
  component: import CustomQuizResultsPage from "@src/quiz-builder/CustomQuizResultsPage"
}

action startCustomQuizAttempt {
  fn: import { startCustomQuizAttempt } from "@src/quiz-builder/operations",
  entities: [CustomQuizAttempt, CustomQuizAttemptItem, Question, UserAttempt, QuestionNote]
}

query getCustomQuizAttempt {
  fn: import { getCustomQuizAttempt } from "@src/quiz-builder/operations",
  entities: [CustomQuizAttempt]
}

action saveCustomQuizAnswer {
  fn: import { saveCustomQuizAnswer } from "@src/quiz-builder/operations",
  entities: [CustomQuizAttempt, CustomQuizAttemptItem]
}

action submitCustomQuizAttempt {
  fn: import { submitCustomQuizAttempt } from "@src/quiz-builder/operations",
  entities: [CustomQuizAttempt, CustomQuizAttemptItem, Question]
}

query getCustomQuizResults {
  fn: import { getCustomQuizResults } from "@src/quiz-builder/operations",
  entities: [CustomQuizAttempt]
}
//#endregion

//#region Mock Exams (timed, random-draw-per-attempt from the growing bank)
route MockExamsRoute { path: "/mock-exams", to: MockExamsPage }
page MockExamsPage {
  authRequired: true,
  component: import MockExamsPage from "@src/mock-exams/MockExamsPage"
}

route MockExamInstructionsRoute { path: "/mock-exams/start/:mockTestId", to: MockExamInstructionsPage }
page MockExamInstructionsPage {
  authRequired: true,
  component: import MockExamInstructionsPage from "@src/mock-exams/MockExamInstructionsPage"
}

route MockExamAttemptRoute { path: "/mock-exams/:attemptId", to: MockExamAttemptPage }
page MockExamAttemptPage {
  authRequired: true,
  component: import MockExamAttemptPage from "@src/mock-exams/MockExamAttemptPage"
}

route MockExamResultsRoute { path: "/mock-exams/:attemptId/results", to: MockExamResultsPage }
page MockExamResultsPage {
  authRequired: true,
  component: import MockExamResultsPage from "@src/mock-exams/MockExamResultsPage"
}

query getMockExams {
  fn: import { getMockExams } from "@src/mock-exams/operations",
  entities: [MockTest, MockExamAttempt, Exam]
}

query getMockExamAttempt {
  fn: import { getMockExamAttempt } from "@src/mock-exams/operations",
  entities: [MockExamAttempt]
}

query getMockExamResults {
  fn: import { getMockExamResults } from "@src/mock-exams/operations",
  entities: [MockExamAttempt]
}

query getExamReadiness {
  fn: import { getExamReadiness } from "@src/mock-exams/operations",
  entities: [MockTest, MockExamAttempt, Exam]
}

query getReadinessScore {
  fn: import { getReadinessScore } from "@src/mock-exams/operations",
  entities: [MockExamAttempt, UserAttempt, Subject]
}

query getMockTestMeta {
  fn: import { getMockTestMeta } from "@src/mock-exams/operations",
  entities: [MockTest]
}

action startMockExamAttempt {
  fn: import { startMockExamAttempt } from "@src/mock-exams/operations",
  entities: [MockTest, MockExamAttempt, Question]
}

action saveMockExamAnswer {
  fn: import { saveMockExamAnswer } from "@src/mock-exams/operations",
  entities: [MockExamAttempt, MockExamAttemptItem]
}

action submitMockExamAttempt {
  fn: import { submitMockExamAttempt } from "@src/mock-exams/operations",
  entities: [MockExamAttempt, MockExamAttemptItem, Question]
}
//#endregion

//#region Progress (per-subject accuracy for the logged-in user)
route ProgressRoute { path: "/progress", to: ProgressPage }
page ProgressPage {
  authRequired: true,
  component: import ProgressPage from "@src/dashboard/ProgressPage"
}

query getMyProgress {
  fn: import { getMyProgress } from "@src/dashboard/operations",
  entities: [UserAttempt]
}
//#endregion

//#region Dashboard home (real-data overview, no fabricated stats)
route DashboardHomeRoute { path: "/dashboard", to: DashboardHomePage }
page DashboardHomePage {
  authRequired: true,
  component: import DashboardHomePage from "@src/dashboard/DashboardHomePage"
}

query getMyDashboardOverview {
  fn: import { getMyDashboardOverview } from "@src/dashboard/operations",
  entities: [UserAttempt]
}

query getMyStudyStats {
  fn: import { getMyStudyStats } from "@src/dashboard/operations",
  entities: [UserAttempt, MockExamAttempt]
}

query getMyStudyPlan {
  fn: import { getMyStudyPlan } from "@src/dashboard/operations",
  entities: [UserAttempt, Subject, UserProfile]
}
//#endregion

//#region Onboarding (mandatory one-time profile capture before dashboard access)
route OnboardingRoute { path: "/onboarding", to: OnboardingPage }
page OnboardingPage {
  authRequired: true,
  component: import OnboardingPage from "@src/onboarding/OnboardingPage"
}

query getMyOnboardingProfile {
  fn: import { getMyOnboardingProfile } from "@src/onboarding/operations",
  entities: [UserProfile]
}

action completeOnboarding {
  fn: import { completeOnboarding } from "@src/onboarding/operations",
  entities: [UserProfile, Exam]
}

action updateTargetExamDate {
  fn: import { updateTargetExamDate } from "@src/onboarding/operations",
  entities: [UserProfile]
}
//#endregion

//#region Video Lectures (Extended-plan perk — gated in the page component)
route VideoLecturesRoute { path: "/video-lectures", to: VideoLecturesPage }
page VideoLecturesPage {
  authRequired: true,
  component: import VideoLecturesPage from "@src/video-lectures/VideoLecturesPage"
}
//#endregion

//#region Contact Form Messages
route AdminMessagesRoute { path: "/admin/messages", to: AdminMessagesPage }
page AdminMessagesPage {
  authRequired: true,
  component: import AdminMessages from "@src/admin/dashboards/messages/MessagesPage"
}

action createContactFormMessage {
  fn: import { createContactFormMessage } from "@src/admin/dashboards/messages/operations",
  entities: [ContactFormMessage]
}

query getContactFormMessages {
  fn: import { getContactFormMessages } from "@src/admin/dashboards/messages/operations",
  entities: [ContactFormMessage, User]
}

action markMessageRead {
  fn: import { markMessageRead } from "@src/admin/dashboards/messages/operations",
  entities: [ContactFormMessage]
}

action markMessageReplied {
  fn: import { markMessageReplied } from "@src/admin/dashboards/messages/operations",
  entities: [ContactFormMessage]
}

query getUnreadMessageCount {
  fn: import { getUnreadMessageCount } from "@src/admin/dashboards/messages/operations",
  entities: [ContactFormMessage]
}
//#endregion
